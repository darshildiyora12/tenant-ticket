# Copy to .env to change a setting. Every value below is the default.

PORT=3000
DB_PATH=data/triage.db

# Selects both the LLM and the embedding provider. Only "mock" exists today.
AI_PROVIDER=mock

# Cosine similarity at or above this marks a ticket as a duplicate.
DUPLICATE_THRESHOLD=0.9

# Longest wait for one LLM call; after that the ticket goes to needs_review ("timeout").
LLM_TIMEOUT_MS=5000

# Most LLM calls in flight at the same time.
LLM_MAX_CONCURRENCY=3

# How often the worker checks the queue, and when a "processing" ticket counts as stuck.
WORKER_POLL_MS=500
STUCK_AFTER_MS=60000
